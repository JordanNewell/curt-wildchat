{
	"name": "curt-wildchat",
	"version": "1.0.2",
	"description": "Convert WildChat (allenai/WildChat-1M) conversation records to .curt conversation files",
	"license": "MIT",
	"type": "module",
	"engines": {
		"node": ">=18"
	},
	"bin": {
		"curt-wildchat": "dist/cli.js"
	},
	"main": "dist/wildchat.js",
	"types": "dist/wildchat.d.ts",
	"files": [
		"dist"
	],
	"scripts": {
		"build": "tsc",
		"test": "vitest run",
		"prepack": "npm run build"
	},
	"dependencies": {
		"curt-format": "^1.2.0"
	},
	"devDependencies": {
		"@types/node": "^24.19.2",
		"typescript": "^5.9.3",
		"vitest": "^4.1.11"
	},
	"keywords": [
		"curt",
		"wildchat",
		"huggingface",
		"converter"
	],
	"repository": {
		"url": "https://github.com/JordanNewell/curt-wildchat.git",
		"type": "git"
	},
	"homepage": "https://github.com/JordanNewell/curt-wildchat#readme",
	"bugs": {
		"url": "https://github.com/JordanNewell/curt-wildchat/issues"
	}
}
